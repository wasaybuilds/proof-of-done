{
  "name": "proof-of-done",
  "version": "0.2.0",
  "description": "Catch AI coding agents faking \"done\": detects deleted tests, skipped tests and removed assertions by diffing before vs. after.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "cursor",
    "test-integrity",
    "reward-hacking",
    "verification",
    "testing",
    "cli"
  ],
  "homepage": "https://github.com/wasaybuilds/proof-of-done#readme",
  "bugs": {
    "url": "https://github.com/wasaybuilds/proof-of-done/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasaybuilds/proof-of-done.git"
  },
  "license": "MIT",
  "author": "Abdul Wasay (https://github.com/wasaybuilds)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proof-of-done": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-grammars.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "test:package": "npm run build && node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
