{
  "name": "proof-of-done",
  "version": "0.0.0",
  "description": "Independent verification for coding agents' 'done' claims: re-runs tests, detects test tampering, issues signed receipts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wasaybuilds/proof-of-done.git"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "claude-code",
    "test-integrity",
    "reward-hacking",
    "verification"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "proof-of-done": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
